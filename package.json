{
  "name": "sledgames",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "dev:worker": "npm run build && wrangler dev --local --ip 127.0.0.1 --port 8787",
    "test:comments": "node --test tests/comments-proxy.test.mjs",
    "verify:comments:local": "node scripts/verify-comments-local.mjs",
    "check": "astro check",
    "build": "astro build",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm run build && npm test",
    "test:browser": "playwright test",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": { "astro": "7.3.8" },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.56.0",
    "cheerio": "1.1.2",
    "typescript": "^5.9.3",
    "wrangler": "4.151.1"
  }
}
