{
  "name": "sledgames",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm run build && npm test",
    "test:browser": "playwright test",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": { "astro": "7.3.8" },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.56.0",
    "cheerio": "1.1.2",
    "typescript": "^5.9.3"
  }
}
