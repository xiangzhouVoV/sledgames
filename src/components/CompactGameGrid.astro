---
import type { Game } from '../lib/types';
import { gameCategory, gamePath } from '../lib/catalog.mjs';
interface Props { games: Game[] }
const { games } = Astro.props;
---
<div class="game-grid game-grid--compact">
  {games.map(game => <a class="game-card game-card--compact" href={gamePath(game.slug)}>
    <div class="card-art">
      <img src={game.thumbnail} width="480" height="300" loading="lazy" alt="" />
    </div>
    <div class="card-copy">
      <h3>{game.title}<span aria-hidden="true">→</span></h3>
      <span class="card-category">{gameCategory(game)?.label}</span>
    </div>
  </a>)}
</div>
