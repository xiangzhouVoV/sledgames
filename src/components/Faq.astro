---
interface Props { faqs: { q: string; a: string }[]; title?: string }
const { faqs, title = 'FAQs' } = Astro.props;
---
{faqs.length > 0 && <section class="content-section faq"><div class="section-heading"><div><span class="eyebrow">A FEW THINGS TO KNOW</span><h2>{title}</h2></div></div>{faqs.map(faq => <details><summary>{faq.q}<span aria-hidden="true">+</span></summary><p>{faq.a}</p></details>)}</section>}
