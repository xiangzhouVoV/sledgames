---
import { canonical, embedUrl, externalPlayLabel } from '../lib/catalog.mjs';
import type { Game } from '../lib/types';
import WinterScene from './WinterScene.astro';
interface Props { game: Game; eager?: boolean; fitAspectRatio?: boolean }
const { game, eager = false, fitAspectRatio = false } = Astro.props;
const src = embedUrl(game, canonical(Astro.url.pathname));
const portrait = game.embed.height > game.embed.width;
const fitted = portrait || fitAspectRatio;
---
<section class:list={['game-stage', { 'game-stage--portrait': portrait, 'game-stage--fitted': fitted }]} style={fitted ? `--game-ratio: ${game.embed.width / game.embed.height}` : undefined} aria-label={`${game.title} game window`}>
  {src ? <iframe src={src} title={`Play ${game.title}`} width={game.embed.width} height={game.embed.height} loading={eager ? 'eager' : 'lazy'} allow="fullscreen; autoplay; gamepad" allowfullscreen referrerpolicy="strict-origin-when-cross-origin" /> :
    game.externalPlayUrl ? <div class="game-pending game-external">
      {game.thumbnail ? <img class="stage-scene" src={game.thumbnail} alt="" width={game.embed.width} height={game.embed.height} loading={eager ? 'eager' : 'lazy'} /> : <WinterScene id={`stage-${game.slug}`} class="stage-scene" />}
      <div class="stage-caption"><h2>Play Online</h2><a class="button" href={game.externalPlayUrl} target="_blank" rel="noopener noreferrer">Play on {externalPlayLabel(game)} <span aria-hidden="true">↗</span></a><p>Open the creator’s browser game in a new tab.</p></div>
    </div> :
    <div class="game-pending">
      <WinterScene id={`stage-${game.slug}`} class="stage-scene" />
      <div class="stage-caption"><h2>{game.title}</h2><a class="button" href="/games/">Browse games <span aria-hidden="true">→</span></a></div>
    </div>}
</section>
{src && <div class="game-toolbar" data-game-tools>
  <p>Click or tap inside the game to use its controls.</p>
  <div class="game-actions">
    <button type="button" data-game-reload aria-label={`Reload ${game.title}`}>Reload</button>
    <button type="button" data-game-fullscreen aria-label={`Play ${game.title} in fullscreen`}>Fullscreen <span aria-hidden="true">⛶</span></button>
  </div>
  <span class="game-tool-status" role="status" aria-live="polite"></span>
</div>}
{src && <noscript><p class="game-script-note">Enable JavaScript in your browser to play {game.title}.</p></noscript>}
<script>
  document.querySelectorAll<HTMLElement>('[data-game-tools]').forEach(tools => {
    const stage = tools.previousElementSibling as HTMLElement;
    const frame = stage.querySelector('iframe');
    const reload = tools.querySelector<HTMLButtonElement>('[data-game-reload]');
    const fullscreen = tools.querySelector<HTMLButtonElement>('[data-game-fullscreen]');
    const status = tools.querySelector<HTMLElement>('[role="status"]');
    if (!frame || !reload || !fullscreen || !status) return;
    reload.addEventListener('click', () => {
      frame.src = frame.src;
      status.textContent = 'Reloading game…';
    });
    frame.addEventListener('load', () => { status.textContent = ''; });
    if (!document.fullscreenEnabled) {
      fullscreen.hidden = true;
    } else {
      fullscreen.addEventListener('click', async () => {
        try {
          if (document.fullscreenElement) await document.exitFullscreen();
          else await stage.requestFullscreen();
          frame.focus();
        } catch { status.textContent = 'Fullscreen is unavailable. You can still play here.'; }
      });
    }
  });
</script>
