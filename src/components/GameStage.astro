---
import { canonical, embedUrl } from '../lib/catalog.mjs';
import type { Game } from '../lib/types';
import WinterScene from './WinterScene.astro';
interface Props { game: Game; eager?: boolean }
const { game, eager = false } = Astro.props;
const src = embedUrl(game, canonical(Astro.url.pathname));
---
<section class="game-stage" aria-label={`${game.title} game window`}>
  {src ? <iframe src={src} title={`Play ${game.title}`} width={game.embed.width} height={game.embed.height} loading={eager ? 'eager' : 'lazy'} allow="fullscreen; autoplay; gamepad" allowfullscreen referrerpolicy="strict-origin-when-cross-origin" /> :
    <div class="game-pending">
      <WinterScene id={`stage-${game.slug}`} class="stage-scene" />
      <div class="stage-caption"><span class="pill">Coming soon</span><h2>{game.title}</h2><p>The official game is on its way.<br />Browse the collection while you wait.</p><a class="button" href="/games">Browse games <span aria-hidden="true">→</span></a></div>
    </div>}
</section>
