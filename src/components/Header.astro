---
import { categories, games, gamePath, pagePath } from '../lib/catalog.mjs';
import SportIcon from './SportIcon.astro';
const path = pagePath(Astro.url.pathname);
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Sled Games home"><span class="brand-mark"><SportIcon /></span>sled<span>games</span></a>
    <nav aria-label="Main navigation">
      {categories.map(category => <a href={category.path} aria-current={path === category.path ? 'page' : undefined}>{category.title}</a>)}
      <a class="nav-all" href="/games/" aria-current={path === '/games/' ? 'page' : undefined}>All Games <span aria-hidden="true">→</span></a>
    </nav>
  </div>
  <nav class="quick-links container" aria-label="Explore games"><span>Explore games</span>{games.map(game => <a href={gamePath(game.slug)} aria-current={path === gamePath(game.slug) ? 'page' : undefined}>{game.title}</a>)}</nav>
</header>
