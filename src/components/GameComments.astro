---
interface Props { gameSlug: string; gameTitle: string }
const { gameSlug, gameTitle } = Astro.props;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() ?? '';
---
<section class="content-section game-comments" id="comments" aria-labelledby="comments-heading" data-game-comments data-game-slug={gameSlug} data-turnstile-site-key={siteKey}>
  <div class="section-heading">
    <div>
      <span class="eyebrow">SHARE YOUR EXPERIENCE</span>
      <h2 id="comments-heading">Player comments</h2>
      <p>Tips, questions, and thoughts about {gameTitle}.</p>
    </div>
  </div>
  <div class="comments-layout">
    <div class="comments-discussion" aria-label="Approved player comments">
      <p class="comments-note">Comments are reviewed before they appear here.</p>
      <p class="comments-list-status" data-comments-status role="status" aria-live="polite" hidden>Loading comments…</p>
      <ul class="comments-list" data-comments-list aria-label="Player comments" hidden></ul>
      <div class="comments-list-actions">
        <button class="button button--secondary" type="button" data-comments-retry hidden>Try again</button>
        <button class="button button--secondary" type="button" data-comments-more hidden>Load more comments</button>
      </div>
    </div>
    <div class="comment-compose">
      <h3>Leave a comment</h3>
      <p class="comments-note">No account needed. Be kind, stay on topic, and keep personal information private.</p>
      <form data-comment-form hidden>
        <div class="comment-field">
          <label for="comment-nickname">Nickname</label>
          <input id="comment-nickname" name="nickname" autocomplete="nickname" required aria-describedby="comment-nickname-help" />
          <p id="comment-nickname-help" class="comments-help">Choose a nickname, up to 40 characters.</p>
        </div>
        <div class="comment-field">
          <label for="comment-content">Your comment</label>
          <textarea id="comment-content" name="content" rows="5" required aria-describedby="comment-content-help comment-count"></textarea>
          <div class="comment-input-help">
            <p id="comment-content-help" class="comments-help">Up to 2,000 characters.</p>
            <span id="comment-count" class="comments-help" data-comment-count>0 / 2,000</span>
          </div>
        </div>
        <div class="comment-honeypot" aria-hidden="true" inert>
          <label for="comment-website">Leave this field empty</label>
          <input id="comment-website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <div class="comment-challenge" data-comment-challenge></div>
        <p class="comments-help" data-challenge-status role="status" aria-live="polite"></p>
        <button class="button button--secondary challenge-retry" type="button" data-challenge-retry hidden>Retry security check</button>
        <button class="button comment-submit" type="submit" disabled>Submit comment</button>
        <p class="comments-help comment-policy">Your nickname and comment may be published after review. Read our <a href="/privacy-policy/">Privacy Policy</a>.</p>
        <p class="comment-status" data-comment-status role="status" aria-live="polite" aria-atomic="true" tabindex="-1"></p>
      </form>
    </div>
  </div>
  <noscript><p class="comments-note">Enable JavaScript to read and submit comments.</p></noscript>
</section>

<script>
  import '../scripts/comments';
</script>

<style>
  .game-comments { scroll-margin-top: 24px; }
  .comments-layout { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 24px; align-items: start; }
  .comments-discussion, .comment-compose { min-width: 0; padding: 24px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
  .comments-note { font-size: .875rem; }
  .comment-compose > .comments-note { margin-top: 10px; }
  .comments-list-status { margin-top: 24px; font-size: .9375rem; }
  .comments-list { list-style: none; padding: 0; margin: 20px 0 0; }
  .comments-list :global(.comment-item) { padding-block: 20px; border-top: 1px solid var(--line); overflow-wrap: anywhere; }
  .comments-list :global(.comment-meta) { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 4px 12px; }
  .comments-list :global(.comment-name) { color: var(--ink); font-size: .9375rem; }
  .comments-list :global(time) { color: var(--muted); font-size: .75rem; }
  .comments-list :global(.comment-text) { margin-top: 8px; color: var(--ink); font-size: .9375rem; white-space: pre-wrap; }
  .comments-list :global(.comment-reply) { margin-top: 16px; padding-left: 14px; border-left: 3px solid var(--line); }
  .comments-list :global(.comment-reply-label) { font-size: .75rem; font-weight: 700; color: var(--muted); }
  .comments-list-actions { margin-top: 16px; }
  form { margin-top: 22px; }
  .comment-field { margin-bottom: 18px; }
  label { display: block; margin-bottom: 7px; font-size: .875rem; font-weight: 650; }
  input, textarea { display: block; width: 100%; min-width: 0; min-height: 44px; padding: 11px 12px; border: 1px solid var(--muted); border-radius: 8px; background: var(--surface); color: var(--ink); font: inherit; font-size: 1rem; }
  textarea { resize: vertical; }
  input:focus-visible, textarea:focus-visible, .comment-status:focus-visible { outline: 3px solid var(--blue); outline-offset: 3px; }
  .comments-help { font-size: .75rem; color: var(--muted); }
  .comment-field > .comments-help, .comment-input-help { margin-top: 7px; }
  .comment-input-help { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px; }
  [data-comment-count][data-over-limit='true'] { font-weight: 700; color: #b3261e; }
  .comment-honeypot { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .comment-challenge { min-width: 0; }
  [data-challenge-status]:not(:empty) { margin-block: 10px; }
  .comment-submit { margin-top: 4px; cursor: pointer; }
  .button { cursor: pointer; }
  .button[disabled] { opacity: .6; cursor: not-allowed; }
  .button[hidden], form[hidden], .comments-list[hidden], [data-comments-status][hidden] { display: none; }
  .challenge-retry { display: flex; margin-bottom: 12px; }
  .comment-policy { margin-top: 14px; }
  .comment-policy a { text-decoration: underline; text-underline-offset: 3px; }
  .comment-status:not(:empty) { margin-top: 18px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 8px; color: var(--ink); font-size: .875rem; overflow-wrap: anywhere; }
  :global(.christmas-page) .game-comments { --blue: #f2ce87; }
  :global(.christmas-page) .game-comments .button--secondary { color: var(--ink); border-color: var(--line); }
  :global(.christmas-page) .game-comments .button--secondary:hover { background: #294a3a; }
  :global(.christmas-page) [data-comment-count][data-over-limit='true'] { color: #ffb7ad; }
  @media (max-width: 760px) {
    .comments-layout { grid-template-columns: minmax(0, 1fr); gap: 18px; }
  }
  @media (max-width: 400px) {
    .comments-discussion, .comment-compose { padding: 18px 14px; }
    .comment-submit { width: 100%; justify-content: center; }
  }
</style>
