---
const stars = Array.from({ length: 24 }, (_, index) => ({
  left: (index * 43 + 7) % 100,
  top: (index * 31 + 9) % 94,
  size: index % 4 === 0 ? 8 : 4,
  duration: 4 + index % 5,
  delay: -(index % 7),
}));
const giftColors = [
  { box: '#c44249', lid: '#e46260', ribbon: '#f3d398' },
  { box: '#3c8464', lid: '#63a786', ribbon: '#f3d398' },
  { box: '#dab365', lid: '#f4cf85', ribbon: '#b93845' },
];
const gifts = [7, 91, 36, 77, 18, 55, 96, 43, 3, 66, 27, 84, 12, 60, 49, 73].map((left, index) => ({
  left,
  size: 24 + (index % 5) * 4,
  duration: 22 + (index % 6) * 2,
  delay: -(index * 2.7 + 5),
  drift: (index % 2 ? -1 : 1) * (18 + (index % 4) * 8),
  sway: 4 + index % 4,
  ...giftColors[index % giftColors.length],
}));
---
<div class="christmas-atmosphere" aria-hidden="true">
  <div class="christmas-halo"></div>
  {stars.map(star => <span class="christmas-star" style={`left:${star.left}%;top:${star.top}%;--star-size:${star.size}px;--twinkle-time:${star.duration}s;--twinkle-delay:${star.delay}s`} />)}
  <div class="christmas-gifts">
    {gifts.map(gift => <span class="christmas-gift" style={`left:${gift.left}%;--gift-size:${gift.size}px;--fall-time:${gift.duration}s;--fall-delay:${gift.delay}s;--gift-drift:${gift.drift}px;--sway-time:${gift.sway}s;--gift-box:${gift.box};--gift-lid:${gift.lid};--gift-ribbon:${gift.ribbon}`}>
      <svg viewBox="0 0 64 64" fill="none">
        <rect x="11" y="28" width="42" height="31" rx="3" fill="var(--gift-box)" />
        <path d="M32 29h21v27a3 3 0 0 1-3 3H32Z" fill="#000" opacity=".08" />
        <rect x="7" y="22" width="50" height="10" rx="2" fill="var(--gift-lid)" />
        <path d="M28 22h8v37h-8Z" fill="var(--gift-ribbon)" />
        <path d="M32 22C13 21 10 7 19 7c8 0 13 15 13 15Zm0 0C51 21 54 7 45 7c-8 0-13 15-13 15Z" stroke="var(--gift-ribbon)" stroke-width="4" stroke-linejoin="round" />
        <path d="M14 35v15" stroke="#fff" stroke-opacity=".16" stroke-width="2" stroke-linecap="round" />
      </svg>
    </span>)}
  </div>
  <svg class="christmas-forest" viewBox="0 0 1440 240" preserveAspectRatio="xMidYMax slice" fill="none">
    <path d="M0 184c160-43 254 20 387 9s214-45 358-21 258-3 376-22 225 12 319 33v57H0Z" fill="#0b2422" />
    <g fill="#173c33">
      <path d="m22 19-41 68h22l-39 61h28l-44 66H96l-43-66h27L42 87h21Z" />
      <path d="m165 64-33 52h17l-33 47h21l-34 50h124l-34-50h21l-33-47h17Z" />
      <path d="m1245 42-39 64h21l-36 54h25l-41 60h140l-42-60h26l-37-54h21Z" />
      <path d="m1405 2-49 80h26l-46 67h31l-51 77h178l-52-77h31l-47-67h26Z" />
    </g>
    <path d="M0 220c210-27 331 3 529 2s366-16 537-11 230 19 374 4v25H0Z" fill="#dbe8da" opacity=".08" />
  </svg>
</div>
<style>
  .christmas-atmosphere { position: fixed; inset: 0; z-index: -1; overflow: hidden; contain: strict; pointer-events: none; user-select: none; }
  .christmas-halo { position: absolute; inset: 0; background: radial-gradient(ellipse at 88% 18%, #e8c87812, transparent 38%), radial-gradient(ellipse at 4% 65%, #b9333410, transparent 45%); }
  .christmas-star { position: absolute; width: var(--star-size); height: var(--star-size); background: #f4d38f; clip-path: polygon(50% 0, 61% 37%, 100% 50%, 61% 63%, 50% 100%, 39% 63%, 0 50%, 39% 37%); opacity: .3; animation: holiday-twinkle var(--twinkle-time) var(--twinkle-delay) ease-in-out infinite; }
  .christmas-gifts { position: absolute; inset: 0; }
  .christmas-gift { position: absolute; top: -64px; width: var(--gift-size); height: var(--gift-size); opacity: 0; animation: gift-fall var(--fall-time) var(--fall-delay) linear infinite; }
  .christmas-gift svg { width: 100%; height: 100%; overflow: visible; animation: gift-sway var(--sway-time) var(--fall-delay) ease-in-out infinite alternate; }
  .christmas-forest { position: absolute; width: 100%; height: 240px; bottom: 0; }
  @keyframes holiday-twinkle { 0%, 100% { opacity: .18; transform: scale(.7); } 50% { opacity: .75; transform: scale(1.15); } }
  @keyframes gift-fall { 0% { transform: translate3d(0, 0, 0); opacity: 0; } 10%, 85% { opacity: .65; } 100% { transform: translate3d(var(--gift-drift), calc(100svh + 128px), 0); opacity: 0; } }
  @keyframes gift-sway { from { transform: rotate(-14deg); } to { transform: rotate(14deg); } }
  @media (max-width: 600px) {
    .christmas-star:nth-of-type(n + 13) { display: none; }
    .christmas-gift:nth-child(n + 7) { display: none; }
    .christmas-gift { width: calc(var(--gift-size) * .8); height: calc(var(--gift-size) * .8); }
    .christmas-forest { height: 160px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .christmas-star { animation: none; opacity: .35; }
    .christmas-gifts { display: none; }
    .christmas-gift, .christmas-gift svg { animation: none; }
  }
</style>
