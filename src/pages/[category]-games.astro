---
import Layout from '../layouts/Layout.astro';
import GameGrid from '../components/GameGrid.astro';
import Faq from '../components/Faq.astro';
import CategoryLinks from '../components/CategoryLinks.astro';
import ChristmasHero from '../components/ChristmasHero.astro';
import { categories, categoryGames, games as allGames, winterCollection, faqSchema, breadcrumbSchema, gamePath } from '../lib/catalog.mjs';
import { categoryContent } from '../lib/category-content.mjs';
export function getStaticPaths() {
  return categories.filter(category => category.path !== '/').map(category => ({ params: { category: category.slug.replace(/-games$/, '') }, props: { category, content: categoryContent[category.slug as keyof typeof categoryContent] } }));
}
interface Props {
  category: (typeof categories)[number];
  content: (typeof categoryContent)[keyof typeof categoryContent];
}
const { category, content } = Astro.props;
const games = categoryGames(category.slug);
const snowfall = ['snowboard-games', 'ski-games'].includes(category.slug);
const winterRecommendations = allGames.filter(game => game.category.some(slug => slug === 'sledding-games' || slug === winterCollection.slug));
const christmas = category.slug === 'christmas-games';
const unlinkedGameSlugs = 'unlinkedGameSlugs' in content ? content.unlinkedGameSlugs : [];
const gameLinks = new Map(allGames.filter(game => !unlinkedGameSlugs.includes(game.slug)).map(game => [game.title, gamePath(game.slug)]));
if ('gameLinkAliases' in content) {
  for (const [text, slug] of Object.entries(content.gameLinkAliases)) gameLinks.set(text, gamePath(slug));
}
const anchorTexts = [...gameLinks.keys()].sort((left, right) => right.length - left.length).map(text => text.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
const gameAnchorPattern = new RegExp(`(${anchorTexts.join('|')})`, 'g');
const proseParts = (paragraph: string) => (christmas ? paragraph.split(gameAnchorPattern) : [paragraph]).map(text => ({ text, href: christmas ? gameLinks.get(text) : undefined }));
const proseParagraphs = content.paragraphs.map(proseParts);
const proseSections = 'sections' in content ? content.sections.map(section => ({ heading: section.heading, parts: proseParts(section.paragraph) })) : [];
const collectionHeadingId = `${category.slug}-collection`;
const collectionHeading = `Choose your ${christmas ? 'Christmas' : category.title.replace(/ Games$/, '').toLowerCase()} game`;
const title = christmas ? 'Christmas Games - Play Free Santa & Sleigh Games Online' : `${category.title} - Free Online ${category.label} Games`;
---
<Layout snowfall={snowfall} theme={christmas ? 'christmas' : undefined} title={title} description={content.description} schema={[faqSchema(content.faqs), breadcrumbSchema([{ name: category.title, path: category.path }])]}>
  {christmas ? <ChristmasHero description={category.description} /> : <section class="page-intro"><span class="eyebrow">PICK YOUR PATH / {category.label}</span><h1>{category.title}</h1><p>{category.description}</p></section>}
  {games.length > 0 && <section class:list={['content-section', 'primary-collection', { 'christmas-collection': christmas }]} aria-labelledby={collectionHeadingId} id={christmas ? 'christmas-play' : undefined}>
    <div class="section-heading"><div>{christmas && <span class="eyebrow">UNWRAP A LITTLE FUN</span>}<h2 id={collectionHeadingId}>{collectionHeading}</h2></div></div>
    <GameGrid games={games} />
  </section>}
  <section class="content-section prose category-guide">
    <h2>Explore {category.title}</h2>
    {proseParagraphs.map(parts => <p>{parts.map(part => part.href ? <a href={part.href}>{part.text}</a> : part.text)}</p>)}
    {proseSections.map(section => <Fragment><h3>{section.heading}</h3><p>{section.parts.map(part => part.href ? <a href={part.href}>{part.text}</a> : part.text)}</p></Fragment>)}
    {content.relatedLink && <a class="text-link" href={content.relatedLink.href}>{content.relatedLink.text} <span aria-hidden="true">→</span></a>}
  </section>
  {winterRecommendations.length > 0 && <section class="content-section" aria-labelledby="other-winter-games"><div class="section-heading"><div><h2 id="other-winter-games">Explore More Winter Games</h2></div></div><GameGrid games={winterRecommendations} /></section>}
  <Faq faqs={content.faqs} />
  <CategoryLinks />
</Layout>

<style>
  .category-guide > h3 { margin-block: 24px 10px; }
</style>
