---
import Layout from '../layouts/Layout.astro';
import GameGrid from '../components/GameGrid.astro';
import Faq from '../components/Faq.astro';
import CategoryLinks from '../components/CategoryLinks.astro';
import ChristmasHero from '../components/ChristmasHero.astro';
import { categories, categoryGames, games as allGames, HOME_GAME_SLUG, winterCollection, faqSchema, breadcrumbSchema } from '../lib/catalog.mjs';
import { categoryContent } from '../lib/category-content.mjs';
export function getStaticPaths() {
  return categories.filter(category => category.path !== '/').map(category => ({ params: { category: category.slug.replace(/-games$/, '') }, props: { category, content: categoryContent[category.slug as keyof typeof categoryContent] } }));
}
interface Props {
  category: (typeof categories)[number];
  content: (typeof categoryContent)['ski-games'];
}
const { category, content } = Astro.props;
const games = categoryGames(category.slug);
const snowfall = ['snowboard-games', 'ski-games'].includes(category.slug);
const winterRecommendations = snowfall ? allGames.filter(game => game.slug !== HOME_GAME_SLUG && game.category.some(slug => slug === 'sledding-games' || slug === winterCollection.slug)) : [];
const christmas = category.slug === 'christmas-games';
const title = christmas ? 'Christmas Games - Play Free Santa & Sleigh Games Online' : `${category.title} - Free Online ${category.label} Games`;
---
<Layout snowfall={snowfall} theme={christmas ? 'christmas' : undefined} title={title} description={content.description} schema={[faqSchema(content.faqs), breadcrumbSchema([{ name: category.title, path: category.path }])]}>
  {christmas ? <ChristmasHero description={category.description} /> : <section class="page-intro"><span class="eyebrow">PICK YOUR PATH / {category.label}</span><h1>{category.title}</h1><p>{category.description}</p></section>}
  {games.length > 0 && <section class:list={['content-section', 'primary-collection', { 'christmas-collection': christmas }]} aria-label={category.title} id={christmas ? 'christmas-play' : undefined}>
    {christmas && <div class="section-heading"><div><span class="eyebrow">UNWRAP A LITTLE FUN</span><h2>Choose your Christmas game</h2></div></div>}
    <GameGrid games={games} />
  </section>}
  <section class="content-section prose"><h2>Explore {category.title}</h2>{content.paragraphs.map(paragraph => <p>{paragraph}</p>)}<a class="text-link" href="/">Play Sled Rider <span aria-hidden="true">→</span></a></section>
  <Faq faqs={content.faqs} />
  {winterRecommendations.length > 0 && <section class="content-section" aria-labelledby="other-winter-games"><div class="section-heading"><div><h2 id="other-winter-games">Explore Other Winter Games</h2></div></div><GameGrid games={winterRecommendations} /></section>}
  <CategoryLinks />
</Layout>
