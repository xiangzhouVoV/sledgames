---
import Layout from '../layouts/Layout.astro';
import { legalContent } from '../lib/legal.mjs';
export function getStaticPaths() { return legalContent.map(page => ({ params: { info: page.slug }, props: { page } })); }
const { page } = Astro.props;
const email = import.meta.env.PUBLIC_CONTACT_EMAIL?.trim();
if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) throw new Error('PUBLIC_CONTACT_EMAIL must be a valid email address');
---
<Layout title={`${page.title} - Sled Games`} description={page.description}>
  <section class="page-intro"><span class="eyebrow">THE DETAILS / SLED GAMES</span><h1>{page.title}</h1><p>{page.intro}</p></section>
  <article class="legal-content prose">
    {page.slug === 'contact' && <section class="contact-box"><h2>Get in touch</h2>{email ? <p>Email us at <a href={`mailto:${email}`}>{email}</a>.</p> : <p>Our contact channel is being prepared. This website is currently a preview.</p>}</section>}
    {page.sections.map(section => <section><h2>{section.title}</h2>{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}</section>)}
    {page.slug !== 'contact' && <p><a class="text-link" href="/contact">Contact Us ↗</a></p>}
  </article>
</Layout>
