---
import Layout from '../layouts/Layout.astro';
import GameGrid from '../components/GameGrid.astro';
import CategoryLinks from '../components/CategoryLinks.astro';
import { games } from '../lib/catalog.mjs';
---
<Layout title="All Games - Free Online Winter Games" description="Browse free winter games online. Explore sledding, snowboard, ski, and Christmas games, find controls and guides, and choose your next browser adventure.">
  <section class="page-intro"><span class="eyebrow">THE WHOLE MOUNTAIN</span><h1>All Games</h1><p>Every adventure, in one place. Pick your next stop.</p></section>
  <section class="content-section"><GameGrid games={games} /></section>
  <CategoryLinks />
</Layout>
