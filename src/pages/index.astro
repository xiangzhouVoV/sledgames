---
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
import GameStage from '../components/GameStage.astro';
import GameGrid from '../components/GameGrid.astro';
import CategoryLinks from '../components/CategoryLinks.astro';
import { games, SITE } from '../lib/catalog.mjs';
const featured = games.find(game => game.slug === 'sled-rider');
if (!featured) throw new Error('The home page requires Sled Rider in data/games.json');
---
<Layout title="Sled Games - Free Online Sledding Games" description="Explore sled games and discover your next winter browser adventure. Browse sledding, snowboard, and ski game pages in one easy-to-navigate collection." schema={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'Sled Games', url: SITE }]}>
  <section class="home-intro"><div><span class="eyebrow">WINTER BROWSER GAMES</span><h1>Sled Games</h1><p>Find your next game. Take on the snow.</p></div><a class="button button--secondary" href="/games">Browse games <span aria-hidden="true">→</span></a></section>
  <div class="stage-heading"><div><span class="featured-label">Featured game</span><a href="/sled-rider">Sled Rider <span aria-hidden="true">→</span></a></div><span class="stage-label">{featured.embed.iframeSrc ? 'PLAY IN YOUR BROWSER' : 'COMING SOON'}</span></div>
  <AdSlot position="top" />
  <GameStage game={featured} eager />
  <AdSlot position="below" />
  <section class="content-section"><div class="section-heading"><div><h2>All games</h2><p>Explore the winter collection.</p></div><a class="text-link" href="/games">View all games <span aria-hidden="true">→</span></a></div><GameGrid games={games} /></section>
  <CategoryLinks />
  <section class="editorial-note"><h2>Winter games, all in one place</h2><p>Browse sledding, snowboarding, and skiing games without an account. Each title has its own page, with an official game window when available. Coming-soon titles join the playable collection once their authorized version is ready.</p><a class="text-link" href="/about">About Sled Games →</a></section>
</Layout>
