---
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
import GameStage from '../components/GameStage.astro';
import GameGrid from '../components/GameGrid.astro';
import GameGuide from '../components/GameGuide.astro';
import Faq from '../components/Faq.astro';
import CategoryLinks from '../components/CategoryLinks.astro';
import { games, SITE, HOME_GAME_SLUG, gameFaqs, gameSchema, faqSchema } from '../lib/catalog.mjs';
const featured = games.find(game => game.slug === HOME_GAME_SLUG);
if (!featured) throw new Error('The home page requires Sled Rider in data/games.json');
const faqs = gameFaqs(featured);
---
<Layout playFirst snowfall title="Sled Games - Free Online Sledding Games" description="Play Sled Rider right in your browser on Sled Games. Ride the snowy slopes for free, then explore our collection of sledding, snowboard, and ski game pages." schema={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'Sled Games', url: SITE }, gameSchema(featured), ...(faqs.length ? [faqSchema(faqs)] : [])]}>
  <h1 class="sr-only">Sled Games</h1>
  <GameStage game={featured} eager />
  <AdSlot position="below" />
  <section class="content-section"><div class="section-heading"><div><h2>All games</h2><p>Explore the winter collection.</p></div><a class="text-link" href="/games">View all games <span aria-hidden="true">→</span></a></div><GameGrid games={games} /></section>
  <GameGuide game={featured} />
  <Faq faqs={faqs} />
  <CategoryLinks />
  <section class="editorial-note"><h2>Winter games, all in one place</h2><p>Play Sled Rider above without a download or a Sled Games account. Learn the controls and find tips for your next run in the guide on this page, then explore our winter game categories.</p><a class="text-link" href="/about">About Sled Games →</a></section>
</Layout>
