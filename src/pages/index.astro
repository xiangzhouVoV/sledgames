---
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
import GameStage from '../components/GameStage.astro';
import GameGrid from '../components/GameGrid.astro';
import CategoryLinks from '../components/CategoryLinks.astro';
import { games, SITE } from '../lib/catalog.mjs';
const featured = games.find(game => game.slug === 'sled-rider');
if (!featured) throw new Error('The home page requires Sled Rider in data/games.json');
---
<Layout playFirst title="Sled Games - Free Online Sledding Games" description="Play Sled Rider right in your browser on Sled Games. Ride the snowy slopes for free, then explore our collection of sledding, snowboard, and ski game pages." schema={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'Sled Games', url: SITE }]}>
  <h1 class="sr-only">Sled Games</h1>
  <GameStage game={featured} eager />
  <AdSlot position="below" />
  <section class="content-section"><div class="section-heading"><div><h2>All games</h2><p>Explore the winter collection.</p></div><a class="text-link" href="/games">View all games <span aria-hidden="true">→</span></a></div><GameGrid games={games} /></section>
  <CategoryLinks />
  <section class="editorial-note"><h2>Winter games, all in one place</h2><p>Start with Sled Rider, playable above without a download or a Sled Games account. Explore the collection to find your next winter adventure, or open the game page for more details.</p><a class="text-link" href="/about">About Sled Games →</a></section>
</Layout>
