---
import '../styles/global.css';
import '../styles/christmas.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Snowfall from '../components/Snowfall.astro';
import ChristmasAtmosphere from '../components/ChristmasAtmosphere.astro';
import GoogleTag from '../components/GoogleTag.astro';
import { canonical, serializeSchema } from '../lib/catalog.mjs';
interface Props {
  title: string;
  description: string;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  playFirst?: boolean;
  snowfall?: boolean;
  theme?: 'christmas';
  socialImage?: string;
  socialImageAlt?: string;
}
const { title, description, schema = [], noindex = false, playFirst = false, snowfall = false, theme, socialImage, socialImageAlt = title } = Astro.props;
const url = canonical(Astro.url.pathname);
const socialImageUrl = socialImage ? new URL(socialImage, url).href : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <GoogleTag />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={theme === 'christmas' ? '#102e2b' : '#13294b'} />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    {socialImageUrl && <>
      <meta property="og:image" content={socialImageUrl} />
      <meta property="og:image:alt" content={socialImageAlt} />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={title} />
      <meta name="twitter:description" content={description} />
      <meta name="twitter:image" content={socialImageUrl} />
      <meta name="twitter:image:alt" content={socialImageAlt} />
    </>}
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5598323555742768"
      crossorigin="anonymous"></script>
    {schema.map(item => <script type="application/ld+json" set:html={serializeSchema(item)} />)}
  </head>
  <body class:list={{ 'play-first': playFirst, 'has-snow': snowfall, 'christmas-page': theme === 'christmas' }}>
    {snowfall && <Snowfall />}
    {theme === 'christmas' && <ChristmasAtmosphere />}
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="container"><slot /></main>
    <Footer />
  </body>
</html>
